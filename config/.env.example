# =============================================================
# 量化平台敏感配置模板
# =============================================================
# 使用方法：
#   1. 将此文件复制为 config/.env（gitignore 已屏蔽该文件）
#   2. 填入真实的 Token / Key 与数据根目录
#   3. 重启应用或脚本后配置自动生效
# =============================================================

# Tushare 数据接口 Token
TUSHARE_TOKEN=your_tushare_token_here

# 同花顺（Fuyao / StraightFlush）API Key
STRIGHT_FLUSH_TOKEN=your_fuyao_api_key_here

# QDCData：默认走 qdc-cli（需先执行 qdc-cli login && qdc-cli config --dir <路径>）
# 可选：指定 QDC 本地数据目录（覆盖 qdc-cli config 的 download_root）
# QDC_DATA_DIR=/path/to/QDCData

# 可选：QDCData 在线 HTTP API（仅当显式使用 mode="http" 时需要）
QDC_API_KEY=your_qdc_api_key_here
QDC_DEVICE=your_device_id_here

# 统一数据根目录
QUANT_DATA_ROOT=/Users/nachuan/Documents/Quant_Data
