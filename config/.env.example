# =============================================================
# 量化平台敏感配置模板
# =============================================================
# 使用方法：
#   1. 将此文件复制为 config/.env（gitignore 已屏蔽该文件）
#   2. 填入真实的 Token / Key 与数据根目录
#   3. 重启应用或脚本后配置自动生效
# =============================================================

# Tushare 数据接口 Token
TUSHARE_TOKEN=your_tushare_token_here

# 统一数据根目录
QUANT_DATA_ROOT=/Users/nachuan/Documents/Quant_Data
