  "cards": [
    {
      "dot": "emerald",
      "title": "零运维进程内调度",
      "items": [
        "V1 采用 APScheduler BlockingScheduler 顺序执行 5 类 Job，拒绝 Celery/Airflow 重部署",
        "每次 run_job 记录 run_id / duration_s / retry_count / 四态结果到 logs/runs/jobs.jsonl"
      ]
    },
    {
      "dot": "rose",
      "title": "非对称失败传导铁律",
      "items": [
        "数据或因子失败时，下游信号与执行立即标 SKIPPED 避免脏算",
        "信号 Job 失败强制执行 hold（保持上日 Portfolio）并告警，绝不自动清仓"
