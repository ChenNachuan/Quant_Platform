  "cards": [
    {
      "dot": "emerald",
      "title": "三步主链契约",
      "items": [
        "时间推进采用 for date in rebalance_dates() 顺序调用，无事件驱动引擎",
        "AlphaSignal 与 TargetPortfolio 是 research/ 与 execution/ 的唯一薄壳边界"
      ]
    },
    {
      "dot": "cyan",
      "title": "因子流水线与落盘分离",
      "items": [
        "factors/ 仅持久化原始因子值，去极值/标准化/中性化在消费时按日截面执行",
        "alphalens 仅作回测前快速筛选门控，结论冲突时以正式回测为准"
      ]
    },
    {
      "dot": "rose",
      "title": "执行闭环内聚",
      "items": [
        "风控检查 + 撮合 + 费用 + 记账统一封装在 broker.submit_orders() 内",
        "SimBroker 与 QmtBroker 共用同一主链，消除回测与实盘代码分歧"
      ]
    }
  ]
}
