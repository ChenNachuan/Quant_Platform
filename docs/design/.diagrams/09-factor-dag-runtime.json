    },
    {
      "id": "save_out",
      "lane": "plan",
      "col": 5,
      "type": "database",
      "label": "存盘并返回 DF",
      "sublabel": "factors/ + {name: df}",
      "width": 138
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "dag",
      "to": "layers",
      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "layers",
