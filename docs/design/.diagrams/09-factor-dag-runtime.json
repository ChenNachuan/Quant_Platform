      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e7",
      "from": "pool_run",
      "to": "safe_skip",
      "label": "异常捕获",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e8",
      "from": "pool_run",
      "to": "save_out",
      "variant": "emphasis"
    },
    {
      "id": "e9",
      "from": "ml_run",
      "to": "save_out",
      "label": "串行汇总",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "简洁高效两模式缓存",
      "items": [
        "缓存键为 (factor_name, version, date_range, depends_hash)；version 变或上游修订一律触发 full 重算",
        "普通因子通过 ProcessPoolExecutor 层内全日期向量化并行，无需按日期切分多 pod"
      ]
    },
    {
      "dot": "rose",
      "title": "ML 隔离与失败传导",
      "items": [
        "MLFactor 强制串行执行并严格按 train_end 切分防 look-ahead，模型用 joblib 持久化",
        "compute_all_safe 下某因子失败仅跳过其下游依赖节点，同层独立因子不受阻塞"
      ]
    }
  ]
}
