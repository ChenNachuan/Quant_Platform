      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "dag",
    "layers",
    "cache_chk",
    "pool_run",
    "save_out"
  ],
  "nodes": [
    {
      "id": "dag",
      "lane": "plan",
      "col": 0,
      "type": "backend",
      "label": "FactorDAG 建图",
      "sublabel": "解析 factor: 前缀 · 判环",
      "width": 138
    },
    {
      "id": "layers",
      "lane": "plan",
      "col": 1,
      "type": "backend",
      "label": "topological_layers",
      "sublabel": "Kahn 算法生成分层",
      "width": 138
    },
    {
      "id": "cache_chk",
      "lane": "plan",
      "col": 2,
      "type": "security",
      "label": "缓存与依赖指纹",
      "sublabel": "(name, ver, range, hash)",
      "tag": "version 变更全量",
      "width": 138
    },
    {
      "id": "cache_hit",
      "lane": "parallel",
      "col": 3,
      "type": "database",
      "label": "命中 / 增量 append",
      "sublabel": "仅补算新交易日",
      "width": 138
    },
    {
      "id": "pool_run",
      "lane": "parallel",
      "col": 4,
      "type": "backend",
      "label": "ProcessPoolExecutor",
      "sublabel": "层内无依赖因子并行",
      "width": 138
    },
    {
      "id": "ml_run",
      "lane": "ml",
      "col": 3,
      "type": "cloud",
      "label": "MLFactor 串行隔离",
