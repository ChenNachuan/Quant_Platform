      "id": "parallel",
      "label": "普通因子分层并行"
    },
    {
      "id": "plan",
      "label": "DAG 规划与落盘"
    },
    {
      "id": "ml",
      "label": "ML 串行与容错分支",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "p1",
      "label": "建图与分层",
