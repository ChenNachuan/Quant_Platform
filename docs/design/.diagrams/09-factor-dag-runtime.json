      "variant": "emphasis"
    },
    {
      "id": "e3",
      "from": "cache_chk",
      "to": "cache_hit",
      "label": "命中/append",
      "variant": "dashed"
    },
    {
      "id": "e4",
      "from": "cache_chk",
      "to": "pool_run",
      "label": "miss/force",
      "variant": "emphasis"
    },
    {
      "id": "e5",
      "from": "cache_hit",
      "to": "pool_run",
      "variant": "dashed"
    },
    {
      "id": "e6",
      "from": "cache_chk",
      "to": "ml_run",
