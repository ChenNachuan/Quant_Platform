    },
    {
      "id": "ops_logs",
      "type": "cloud",
      "label": "logs/runs/",
      "sublabel": "jobs / backtests / live .jsonl",
      "row": 2,
      "col": 2,
      "size": [195, 68]
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "$QUANT_DATA_ROOT 持久化数据根（无 ext/ 与 cn_reference/ 混合目录）",
