      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "c-raw-asset",
      "from": "raw_dir",
      "to": "asset_dir",
      "label": "Normalize + DQC 通过",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "c-raw-quar",
      "from": "raw_dir",
      "to": "quarantine_dir",
      "label": "HARD 拒收",
      "variant": "security",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "c-quar-audit",
      "from": "quarantine_dir",
      "to": "audit_dirs",
      "label": "写 DQC / 比对日志",
      "variant": "dashed",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "c-asset-duck",
      "from": "asset_dir",
      "to": "duckdb_cat",
      "label": "注册 Parquet 视图",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "c-factors-duck",
      "from": "factors_dir",
      "to": "duckdb_cat",
      "label": "注册因子视图",
      "variant": "default",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "c-duck-api",
      "from": "duckdb_cat",
      "to": "data_api",
      "label": "SQL / Arrow 导出",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "c-duck-logs",
      "from": "duckdb_cat",
      "to": "ops_logs",
      "label": "运行与巡检记录",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "52 张表平铺命名规范",
      "items": [
        "取消独立 ext/ 与混合 cn_reference/，asset/ 统一按 {nation}_{asset_type}_{data_type} 建表",
        "factors/ 与 asset/ 平级存放，旧 10 个短名通过 LEGACY_TO_CANONICAL 透明兼容"
      ]
    },
    {
      "dot": "emerald",
      "title": "分区与复权红线",
      "items": [
        "高频行情按 {date}.parquet、日频小截面按 {month}.parquet、财报事件按 {year}.parquet 分区",
        "表内只存未复权价格与 adjfactor；前/后复权均由 DataAPI 在读时派生，绝不落盘"
      ]
    }
  ]
