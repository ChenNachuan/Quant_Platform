      "tag": "原样落盘 · 保留 1 年"
    },
    {
      "id": "quarantine_dir",
      "type": "security",
      "label": "quarantine/",
      "sublabel": "{asset}/{date} + rejection.json",
      "row": 0,
      "col": 2,
      "size": [195, 68],
      "tag": "DQC 拒收 · T+30 清理"
    },
    {
      "id": "audit_dirs",
      "type": "security",
      "label": "dqc/ · cross_check/ · manifest/",
