{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "$QUANT_DATA_ROOT 五层存储与 DuckDB 拓扑",
    "subtitle": "Parquet 唯一持久化真相 + catalog.duckdb 持久化视图与缓存",
    "locale": "zh-CN",
    "output": "docs/design/.diagrams/03-storage-topology.html",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "external": { "label": "外部采集输入" },
        "database": { "label": "Parquet 分区存储" },
        "security": { "label": "隔离区与校验审计" },
        "backend": { "label": "查询与调度服务" },
        "cloud": { "label": "运维日志旁路" }
      }
    }
  },
  "layout": {
    "mode": "grid",
